# AI Employee Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Gmail OAuth2 Configuration (for Gmail Watcher + MCP)
# =============================================================================
# Create credentials at: https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret

# =============================================================================
# WhatsApp Business API Configuration
# =============================================================================
# Get from Meta Business Suite: https://business.facebook.com/
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token

# =============================================================================
# LinkedIn API Configuration
# =============================================================================
# Create app at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# =============================================================================
# Vault Configuration
# =============================================================================
# Absolute path to Obsidian vault root
VAULT_PATH=C:/Users/YourName/Documents/ObsidianVault

# =============================================================================
# Operational Modes
# =============================================================================
# Set to true for testing without real API calls
DRY_RUN=false

# Set to true for development mode (verbose logging, shorter intervals)
DEV_MODE=false

# =============================================================================
# Database Configuration
# =============================================================================
# Path to SQLite idempotency database (relative to project root)
IDEMPOTENCY_DB_PATH=data/idempotency.db

# =============================================================================
# Webhook Server Configuration (for WhatsApp)
# =============================================================================
# Port for FastAPI webhook server
WEBHOOK_PORT=8000

# Public URL for webhook callbacks (use ngrok for local development)
WEBHOOK_PUBLIC_URL=https://your-domain.com/webhooks

# =============================================================================
# Odoo Community ERP Configuration (Gold Tier)
# =============================================================================
# Odoo server connection settings
ODOO_HOST=localhost
ODOO_PORT=8069
ODOO_DATABASE=ai_employee
ODOO_USERNAME=admin
# Note: API key stored in OS credential manager as 'odoo_api_key'

# =============================================================================
# Meta Business Suite Configuration (Gold Tier)
# =============================================================================
# Create app at: https://developers.facebook.com/apps
META_APP_ID=your_meta_app_id
# Note: App secret stored in OS credential manager as 'meta_app_secret'

# Facebook Page settings
FB_PAGE_ID=your_facebook_page_id
# Note: Page access token stored in OS credential manager as 'fb_page_token_{page_id}'

# Instagram Business Account settings
IG_USER_ID=your_instagram_business_account_id
# Note: Access token stored in OS credential manager as 'ig_access_token_{ig_user_id}'

# =============================================================================
# Twitter/X API Configuration (Gold Tier)
# =============================================================================
# Create app at: https://developer.x.com/en/portal/dashboard
TWITTER_API_KEY=your_twitter_api_key
TWITTER_ACCESS_TOKEN=your_twitter_access_token
# Note: Secrets stored in OS credential manager:
#   - twitter_api_secret
#   - twitter_access_token_secret
#   - twitter_bearer_token

# =============================================================================
# Gold Tier Feature Flags
# =============================================================================
# Enable/disable Gold Tier features
GOLD_TIER_ENABLED=true
ODOO_INTEGRATION_ENABLED=true
CEO_BRIEFING_ENABLED=true
RALPH_WIGGUM_ENABLED=true
