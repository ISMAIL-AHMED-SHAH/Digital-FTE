  "mcpServers": {
    "odoo": {
      "command": "node",
      "args": [
        "src/mcp_servers/odoo/dist/index.js"
      ],
      "env": {
        "ODOO_URL": "${ODOO_URL}",
        "ODOO_DATABASE": "${ODOO_DATABASE}",
        "ODOO_USERNAME": "${ODOO_USERNAME}",
        "ODOO_PASSWORD": "${ODOO_PASSWORD}",
        "ODOO_API_KEY": "${ODOO_API_KEY}"
      },
      "description": "Odoo ERP integration MCP server for invoice and customer management",
      "autoStart": false,
      "healthCheck": {
        "enabled": true,
        "interval_ms": 60000,
        "timeout_ms": 5000
      },
      "rateLimits": {
        "requests_per_minute": 60,
        "concurrent_requests": 5
      }
    },
    "facebook": {
      "command": "node",
      "args": [
        "src/mcp_servers/meta/dist/facebook.js"
      ],
      "env": {
        "META_APP_ID": "${META_APP_ID}",
        "META_APP_SECRET": "${META_APP_SECRET}",
        "META_ACCESS_TOKEN": "${META_ACCESS_TOKEN}",
        "META_PAGE_ID": "${META_PAGE_ID}"
      },
      "description": "Facebook Page management MCP server for posts and engagement",
      "autoStart": false,
      "healthCheck": {
        "enabled": true,
        "interval_ms": 60000,
        "timeout_ms": 5000
      },
      "rateLimits": {
        "requests_per_hour": 200,
        "posts_per_day": 25
      }
    },
    "instagram": {
      "command": "node",
      "args": [
        "src/mcp_servers/meta/dist/instagram.js"
      ],
      "env": {
        "META_APP_ID": "${META_APP_ID}",
        "META_APP_SECRET": "${META_APP_SECRET}",
        "META_ACCESS_TOKEN": "${META_ACCESS_TOKEN}",
        "INSTAGRAM_BUSINESS_ACCOUNT_ID": "${INSTAGRAM_BUSINESS_ACCOUNT_ID}"
      },
      "description": "Instagram Business account MCP server for media posts",
      "autoStart": false,
      "healthCheck": {
        "enabled": true,
        "interval_ms": 60000,
        "timeout_ms": 5000
      },
      "rateLimits": {
        "requests_per_hour": 200,
        "media_posts_per_day": 25
      }
    },
    "twitter": {
      "command": "node",
      "args": [
        "src/mcp_servers/twitter/dist/index.js"
      ],
      "env": {
        "TWITTER_API_KEY": "${TWITTER_API_KEY}",
        "TWITTER_API_SECRET": "${TWITTER_API_SECRET}",
        "TWITTER_ACCESS_TOKEN": "${TWITTER_ACCESS_TOKEN}",
        "TWITTER_ACCESS_SECRET": "${TWITTER_ACCESS_SECRET}",
        "TWITTER_BEARER_TOKEN": "${TWITTER_BEARER_TOKEN}"
      },
      "description": "Twitter/X MCP server for tweets and engagement",
      "autoStart": false,
      "healthCheck": {
        "enabled": true,
        "interval_ms": 60000,
        "timeout_ms": 5000
      },
      "rateLimits": {
        "tweets_per_day": 100,
        "requests_per_15min": 300
      }
    },
    "whatsapp": {
      "command": "node",
      "args": [
        "src/mcp_servers/whatsapp/dist/index.js"
      ],
      "env": {
        "ACCESS_TOKEN": "${ACCESS_TOKEN}",
        "WHATSAPP_PHONE_NUMBER_ID": "${WHATSAPP_PHONE_NUMBER_ID}",
        "WHATSAPP_BUSINESS_ACCOUNT_ID": "${WHATSAPP_BUSINESS_ACCOUNT_ID}"
      },
      "description": "WhatsApp Business Cloud API MCP server for sending messages",
      "autoStart": false,
      "healthCheck": {
        "enabled": true,
        "interval_ms": 60000,
        "timeout_ms": 5000
      },
      "rateLimits": {
        "messages_per_second": 80,
        "messages_per_day": 1000
      }
    }
  },
  "plugins": {
    "ralph-wiggum": {
      "enabled": true,
      "path": ".claude/plugins/ralph-wiggum",
      "manifest": ".claude/plugins/ralph-wiggum/manifest.json",
      "configuration": {
        "max_iterations": 50,
        "approval_dir": "data/approvals",
        "semantic_detection": true,
        "task_detection": true,
        "approval_detection": true,
        "error_detection": true
      }
    }
  },
  "hooks": {
    "stop": {
      "enabled": true,
      "scripts": [
        {
          "id": "ralph-wiggum-stop",
          "path": ".claude/hooks/ralph-wiggum-stop.sh",
          "priority": 100,
          "timeout_ms": 5000,
          "conditions": {
            "autonomous_mode": true
          }
        }
      ]
    }
  },
  "goldTier": {
    "enabled": true,
    "features": {
      "odoo_integration": true,
      "social_media_mcps": true,
      "ceo_briefing": true,
      "ralph_wiggum_loop": true,
      "graceful_degradation": true,
      "error_categorization": true
    },
    "services": {
      "odoo": {
        "enabled": true,
        "description": "Odoo ERP for invoice and customer management",
        "health_endpoint": "/api/health",
        "retry_config": {
          "max_attempts": 5,
          "initial_delay_ms": 1000,
          "max_delay_ms": 60000,
          "backoff_multiplier": 2
        }
      },
      "facebook": {
        "enabled": true,
        "description": "Facebook Page API",
        "retry_config": {
          "max_attempts": 3,
          "initial_delay_ms": 2000,
          "max_delay_ms": 30000
        }
      },
      "instagram": {
        "enabled": true,
        "description": "Instagram Graph API",
        "retry_config": {
          "max_attempts": 3,
          "initial_delay_ms": 2000,
          "max_delay_ms": 30000
        }
      },
      "twitter": {
        "enabled": true,
        "description": "Twitter/X API v2",
        "retry_config": {
          "max_attempts": 3,
          "initial_delay_ms": 2000,
          "max_delay_ms": 30000
        }
      }
    },
    "ceoBriefing": {
      "schedule": "0 7 * * 1-5",
      "timezone": "America/New_York",
      "delivery": {
        "method": "email",
        "fallback": "dashboard"
      },
      "sections": [
        "financial_summary",
        "social_engagement",
        "pending_actions",
        "system_health"
      ]
    },
    "ralphWiggum": {
      "enabled": true,
      "maxIterations": 50,
      "completionDetection": {
        "semantic": true,
        "taskBased": true,
        "checkpoint": true,
        "errorState": true
      },
      "approvalDir": "data/approvals",
      "logFile": "logs/ralph-wiggum-stop.log"
    },
    "auditLogging": {
      "enabled": true,
      "retentionDays": 90,
      "compressionDays": 30,
      "maxSizeBytes": 1073741824,
      "alertThreshold": 0.8
    },
    "gracefulDegradation": {
      "enabled": true,
      "queuePath": "data/action_queue.json",
      "processingIntervalSeconds": 60,
      "maxRetries": 5
    }
  }
}
